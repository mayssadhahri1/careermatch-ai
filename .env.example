# Copier ce fichier en .env puis adapter les valeurs

# Base de données (SQLite par défaut)
DATABASE_URL=sqlite:///./careermatch.db

# Fournisseur LLM : none | ollama | openai
LLM_PROVIDER=none
LLM_MODEL=llama3.1

# Ollama (modèle local)
OLLAMA_BASE_URL=http://localhost:11434

# API compatible OpenAI (OpenAI, Groq, Mistral, OpenRouter...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
